name: Build APK

on: [push, workflow_dispatch]

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.9
      - name: Write project
        run: |
          mkdir -p app/src/main/kotlin/com/partypame
          cat > settings.gradle <<'EOF_0'
          pluginManagement {repositories{mavenCentral();gradlePluginPortal()}}
          dependencyResolutionManagement {repositories{mavenCentral()}}
          rootProject.name = 'partygame'
          include ':app'
          EOF_0
          cat > build.gradle <<'EOF_1'
          plugins {id 'com.android.application'}
          android {
              namespace 'com.partygame'
              compileSdk 34
              defaultConfig {
                  applicationId 'com.partygame'
                  minSdk 24
                  targetSdk 34
                  versionCode 1
                  versionName '1.0'
              }
          }
          dependencies {
              implementation 'org.java-websocket:Java-WebSocket:1.5.6'
          }
          EOF_1
          mkdir -p app/src/main
          cat > app/src/main/AndroidManifest.xml <<'EOF_2'
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">
              <uses-permission android:name="android.permission.INTERNET"/>
              <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
              <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
              <application android:allowBackup="true" android:label="لعبة البنت والشباب" android:supportsRtl="true" android:theme="@style/Theme.AppCompat.Light.NoActionBar">
                  <activity android:name=".MainActivity" android:exported="true">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN"/>
                          <category android:name="android.intent.category.LAUNCHER"/>
                      </intent-filter>
                  </activity>
              </application>
          </manifest>
          EOF_2
          mkdir -p app/src/main/assets
          cat > app/src/main/assets/index.html <<'EOF_3'
          <!DOCTYPE html>
          <html lang="ar">
          <head>
              <meta charset="UTF-8">
              <meta name="viewport" content="width=device-width, initial-scale=1.0">
              <title>لعبة البنت والشباب</title>
              <style>
                  body { font-family: Tahoma, sans-serif; background: #121212; color: #fff; text-align: center; margin: 0; padding: 20px; }
                  button { background: #ff4081; color: white; border: none; padding: 10px 20px; font-size: 16px; border-radius: 5px; cursor: pointer; margin: 5px; }
                  button:hover { background: #f50057; }
                  input { padding: 10px; font-size: 16px; border-radius: 5px; border: 1px solid #ccc; width: 80%; max-width: 300px; margin: 10px; }
                  #lobby, #game { display: none; }
              </style>
          </head>
          <body>
              <h1>لعبة البنت والشباب</h1>
              <div id="lobby">
                  <input type="text" id="nameInput" placeholder="أدخل اسمك">
                  <br>
                  <button onclick="createRoom()">إنشاء غرفة</button>
                  <button onclick="joinRoom()">انضمام لغرفة</button>
              </div>
              <div id="game">
                  <h2 id="roomTitle"></h2>
                  <div id="questionArea"></div>
                  <input type="text" id="answerInput" placeholder="اكتب إجابتك هنا">
                  <button onclick="sendAnswer()">إرسال</button>
                  <div id="scores"></div>
              </div>
              <script>
                  let ws, myName, roomCode, isHost = false;
                  function showLobby() { document.getElementById('lobby').style.display = 'block'; }
                  function createRoom() {
                      myName = document.getElementById('nameInput').value;
                      if(!myName) return alert('الرجاء إدخال الاسم');
                      isHost = true;
                      initWS('create');
                  }
                  function joinRoom() {
                      myName = document.getElementById('nameInput').value;
                      roomCode = prompt('أدخل رمز الغرفة:');
                      if(!myName || !roomCode) return alert('الرجاء إدخال الاسم ورمز الغرفة');
                      initWS('join');
                  }
                  function initWS(action) {
                      ws = new WebSocket('wss://echo.websocket.events');
                      ws.onopen = () => {
                          ws.send(JSON.stringify({action, name: myName, code: roomCode}));
                          document.getElementById('lobby').style.display = 'none';
                          document.getElementById('game').style.display = 'block';
                          document.getElementById('roomTitle').innerText = action === 'create' ? 'غرفة جديدة' : 'غرفة رقم: ' + roomCode;
                      };
                      ws.onmessage = (event) => {
                          let data = JSON.parse(event.data);
                          if(data.type === 'question') {
                              document.getElementById('questionArea').innerHTML = '<h3>' + data.text + '</h3>';
                          }
                      };
                  }
                  function sendAnswer() {
                      let ans = document.getElementById('answerInput').value;
                      ws.send(JSON.stringify({type: 'answer', answer: ans}));
                  }
                  showLobby();
              </script>
          </body>
          </html>
          EOF_3
          mkdir -p app/src/main/kotlin/com/partygame
          cat > app/src/main/kotlin/com/partygame/MainActivity.kt <<'EOF_4'
          package com.partygame
          import android.os.Bundle
          import android.webkit.WebView
          import android.webkit.WebSettings
          import androidx.appcompat.app.AppCompatActivity
          class MainActivity : AppCompatActivity() {
              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)
                  val webView = WebView(this)
                  setContentView(webView)
                  val webSettings: WebSettings = webView.settings
                  webSettings.javaScriptEnabled = true
                  webSettings.domStorageEnabled = true
                  webView.loadUrl("file:///android_asset/index.html")
              }
          }
          EOF_4
      - name: Build with Gradle
        run: ./gradlew assembleDebug
      - name: Find APK
        run: find . -name "*.apk"
      - uses: actions/upload-artifact@v4
        with:
          name: PartyGame-APK
          path: app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: app-debug
          path: app/build/outputs/apk/debug/app-debug.apk
          fail_on_unmatched_files: true
