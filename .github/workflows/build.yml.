          package com.partygame
          import android.annotation.SuppressLint
          import android.app.Activity
          import android.content.Context
          import android.net.wifi.WifiManager
          import android.os.Bundle
          import android.view.WindowManager
          import android.webkit.JavascriptInterface
          import android.webkit.WebView
          import org.java_websocket.WebSocket
          import org.java_websocket.handshake.ClientHandshake
          import org.java_websocket.server.WebSocketServer
          import java.net.InetSocketAddress
          import java.net.NetworkInterface
          import java.util.concurrent.ConcurrentHashMap

          class MainActivity : Activity() {
              lateinit var web: WebView
              var server: WebSocketServer? = null
              val conns = ConcurrentHashMap<Int, WebSocket>()
              var nextId = 1
              fun js(code: String) = runOnUiThread { web.evaluateJavascript(code, null) }

              @SuppressLint("SetJavaScriptEnabled")
              override fun onCreate(b: Bundle?) {
                  super.onCreate(b)
                  window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
                  web = WebView(this)
                  web.settings.javaScriptEnabled = true
                  web.settings.domStorageEnabled = true
                  web.settings.mediaPlaybackRequiresUserGesture = false
                  web.addJavascriptInterface(Bridge(), "Android")
                  setContentView(web)
                  web.loadUrl("file:///android_asset/index.html")
              }

              inner class Bridge {
                  @JavascriptInterface fun startServer() {
                      if (server != null) return
                      val s = object : WebSocketServer(InetSocketAddress(8080)) {
                          override fun onOpen(c: WebSocket, h: ClientHandshake) { val id = nextId++; c.setAttachment(id); conns[id] = c }
                          override fun onMessage(c: WebSocket, m: String) { val id = c.getAttachment<Int>(); js("hostOnMsg(" + id + "," + org.json.JSONObject.quote(m) + ")") }
                          override fun onClose(c: WebSocket, code: Int, r: String?, remote: Boolean) { val id = c.getAttachment<Int>(); conns.remove(id); js("hostOnClose(" + id + ")") }
                          override fun onError(c: WebSocket?, e: Exception?) {}
                          override fun onStart() {}
                      }
                      s.isReuseAddr = true
                      s.start()
                      server = s
                  }
                  @JavascriptInterface fun bcast(m: String) { for (c in conns.values) { try { c.send(m) } catch (e: Exception) {} } }
                  @JavascriptInterface fun sendTo(id: Int, m: String) { try { conns[id]?.send(m) } catch (e: Exception) {} }
                  @JavascriptInterface fun ip(): String {
                      val l = ArrayList<String>()
                      for (n in NetworkInterface.getNetworkInterfaces()) for (a in n.inetAddresses)
                          if (!a.isLoopbackAddress && a.address.size == 4) l.add(a.hostAddress ?: "")
                      return l.joinToString(" | ")
                  }
                  @JavascriptInterface fun gateway(): String {
                      val g = (applicationContext.getSystemService(Context.WIFI_SERVICE) as WifiManager).dhcpInfo.gateway
                      return (g and 255).toString() + "." + ((g shr 8) and 255) + "." + ((g shr 16) and 255) + "." + ((g shr 24) and 255)
                  }
              }
          }
